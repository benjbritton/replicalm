# Local renders, archive binaries and working intermediates. These are
# gigabytes of derived rasters and point clouds; everything needed to
# regenerate them is tracked, and archive/README.md says how.
render*/
archive/*
!archive/README.md
tests/
benchmarks/*/*.las
benchmarks/*/*.laz
benchmarks/*/*.tif
*.las
*.laz
*.tif
*.tiff
*.ovr
*.aux.xml

# Logs
*.log

# Figures are tracked; other images are not
*.jpg
*.jpeg

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/

# Editors and OS
.~lock.*#
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Installer build artifacts: a packed environment and a compiled setup.exe,
# both rebuilt by packaging/build.ps1
packaging/stage/
packaging/dist/
packaging/*.log

# Word lock files
~$*

# Run outputs written into the repo root by testing
/*_config.json
/*_DEM.tif
/*_ground.las
/rvt/

# New River / Ka'Kabish block. The point clouds are Alec McLellan's and nothing
# derived from them is published without his approval, so the measurements live
# outside the repository -- REPLICALM_NR_RESULTS, default
# C:\NR_Lidar\replicalm_results. The scripts that produce them are tracked; the
# numbers are not.
benchmarks/results/nr_block/
