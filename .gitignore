# Local renders, archive binaries and working intermediates. These are
# gigabytes of derived rasters and point clouds; everything needed to
# regenerate them is tracked, and archive/README.md says how.
render*/
archive/*
!archive/README.md
tests/
benchmarks/*/*.las
benchmarks/*/*.laz
benchmarks/*/*.tif
*.las
*.laz
*.tif
*.tiff
*.ovr
*.aux.xml

# Logs
*.log

# Figures are tracked; other images are not
*.jpg
*.jpeg

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/

# Editors and OS
.~lock.*#
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Installer build artifacts: a packed environment and a compiled setup.exe,
# both rebuilt by packaging/build.ps1
packaging/stage/
packaging/dist/
packaging/*.log

# Word lock files
~$*

# Run outputs written into the repo root by testing
/*_config.json
/*_DEM.tif
/*_ground.las
/rvt/


# ArcGIS leaves these beside a shapefile while it has the layer open
*.sr.lock

# Superseded drafts and the unfinished paper: kept locally, not published.
# Only the latest overview and report are tracked.
Replicalm_overview_v[1-5].docx
Replicalm_report.docx
Replicalm_report_v[2-3].docx
docs/paper/

# A development handoff note and two post drafts whose finished versions are
# published as markdown under docs/posts/. Kept locally.
HANDOFF.md
Replicalm_post_calibrating_v1.docx
Replicalm_post_specks_v1.docx
